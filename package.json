{
  "name": "square",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.5.0",
  "workspaces": [
    "frontend",
    "shared",
    "backend/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@square/frontend",
    "dev:frontend": "pnpm --filter @square/frontend dev",
    "dev:backend": "pnpm --filter @square/gateway dev",
    "start:backend": "pnpm --filter @square/gateway start",
    "start:worker": "pnpm --filter @square/gateway start:worker",
    "backend:up": "node scripts/parity-backend.mjs up",
    "backend:down": "node scripts/parity-backend.mjs down",
    "backend:reset": "node scripts/parity-backend.mjs reset",
    "parity:mock": "PARITY_TARGET=mock NEXT_PUBLIC_USE_MOCK=true NEXT_PUBLIC_API_URL= pnpm --filter @square/frontend exec vitest run lib/api/parity.test.ts",
    "parity:real": "node scripts/parity-backend.mjs reset && PARITY_TARGET=real NEXT_PUBLIC_USE_MOCK=false NEXT_PUBLIC_API_URL=http://127.0.0.1:4400/v1 pnpm --filter @square/frontend exec vitest run lib/api/parity.test.ts",
    "parity": "pnpm run parity:mock && pnpm run parity:real",
    "build:frontend": "pnpm --filter @square/shared typecheck && pnpm --filter @square/frontend build:prod",
    "start:frontend": "pnpm --filter @square/frontend start:prod",
    "db:migrate": "pnpm --filter @square/gateway migrate",
    "db:status": "pnpm --filter @square/gateway status",
    "build:backend": "turbo run build --filter=@square/gateway...",
    "test:backend": "turbo run test --filter=@square/gateway...",
    "dev:clean": "pnpm --filter @square/frontend dev:clean",
    "build": "pnpm run build:frontend",
    "start": "pnpm run start:frontend",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck --concurrency=2",
    "test": "turbo run test",
    "format": "prettier --write .",
    "audit": "pnpm audit --prod",
    "analyze": "ANALYZE=true pnpm --filter @square/frontend build"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "eslint-plugin-security": "^3.0.1",
    "turbo": "^2.11.13",
    "typescript": "^5.9.3"
  }
}
