# Backend API (backend/kernel/src/config.ts)
# NODE_ENV is REQUIRED (no default) — dev bypasses activate only when set explicitly.
NODE_ENV=development
PORT=4000
SERVICES=all

# Local development defaults. In production, use managed services, TLS, and
# separate credentials for each environment. DATABASE_URL must include
# sslmode=require (or verify-ca/verify-full) in production.
DATABASE_URL="postgresql://postgres.xzoaerqyrkiwxdxkftdu:[YOUR-PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.xzoaerqyrkiwxdxkftdu:[YOUR-PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:5432/postgres"
REDIS_URL=redis://127.0.0.1:6379
DB_POOL_MAX=6


# Exact browser origins, comma-separated. Production origins must use HTTPS.
CORS_ORIGINS=http://localhost:3000

# JWT signing and verification. Generate an Ed25519 key pair and keep the
# private key in your production secret manager.
JWT_ISSUER=square
JWT_AUDIENCE=square-api
# JWT_KEY_ID=v1
# JWT_PUBLIC_KEY=
# JWT_PRIVATE_KEY=
# AUTH_CODE_PEPPER is REQUIRED outside NODE_ENV=test (>=32 chars). Generate with:
#   openssl rand -hex 32
AUTH_CODE_PEPPER=
# AUTH_DEV_BYPASS gates an insecure dev-only access-token shortcut. NEVER enable
# in production (config validation rejects it). Keep false/commented normally.
# AUTH_DEV_BYPASS=false
# DEV_EXPOSE_AUTH_CODE logs the sign-in code in development/test only (never in
# production — config validation rejects it). Default off. The code is never
# returned in any API response regardless of this flag.
# DEV_EXPOSE_AUTH_CODE=false
# COOKIE_DOMAIN=.example.com

# Required in production to protect GET /metrics. Use a unique random secret.
# METRICS_TOKEN=

# Resend email delivery. Required in production; use a verified sender domain.
# RESEND_API_KEY=
# RESEND_SENDER_EMAIL=
RESEND_SENDER_NAME=Square
# Public base URL (frontend/storage) used to host email images at absolute HTTPS
# URLs (e.g. https://app.square.app). Falls back to http://localhost:3000.
# ASSET_BASE_URL=https://app.square.app

# Required together when configuring Cloudinary. Upload signing is not yet
# implemented by the gateway.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=square

# Feature switches
SIGNUP_ENABLED=true
DM_ENABLED=true
UPLOADS_ENABLED=true
ENABLE_TYPING=false
ENABLE_PUSH=false

# Development-only dependency used by /v1/_dev/dummy/health
DUMMY_SERVICE_URL=http://127.0.0.1:4010
