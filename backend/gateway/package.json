{
  "name": "@square/gateway",
  "version": "0.0.0",
  "private": true,
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "description": "Square backend service: gateway",
  "scripts": {
    "dev": "pnpm build && concurrently --kill-others \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch dist/main.js\"",
    "start:dummy": "node dist/dummy.js",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.main.js",
    "status": "tsx src/status.ts",
    "build": "tsc -p tsconfig.build.json",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "pnpm --filter @square/kernel build && vitest run",
    "migrate": "tsx src/migrate.ts"
  },
  "dependencies": {
    "@fastify/compress": "^8.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/static": "^10.1.12",
    "@nestjs/common": "^11.0.11",
    "@nestjs/core": "^11.0.11",
    "@nestjs/platform-fastify": "^11.0.11",
    "@nestjs/swagger": "^11.2.0",
    "@square/kernel": "workspace:*",
    "@square/shared": "workspace:*",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "jose": "^6.2.18",
    "pg": "^8.14.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/pg": "^8.11.13",
    "concurrently": "^10.0.7",
    "tsx": "^4.19.3",
    "typescript": "^6.0.3",
    "vitest": "^3.1.1"
  }
}
